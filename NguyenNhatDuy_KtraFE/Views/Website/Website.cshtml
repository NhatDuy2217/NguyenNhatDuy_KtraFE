<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tiki - Điện Thoại Máy Tính Bảng</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: whitesmoke;
            color: black;
        }

        .top {
            height: 30px;
            background: lightgreen;
            color: green;
            text-align: center;
            padding: 8px;
            font-size: 12px;
        }

        header {
            background: white;
        }

        .header {
            width: 1200px;
            margin: auto;
            height: 70px;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .logo {
            width: 120px;
            color: royalblue;
            font-size: 32px;
            font-weight: bold;
        }

        .logo small {
            display: block;
            font-size: 10px;
            text-align: center;
        }

        .search {
            height: 42px;
            width: 600px;
            border: 1px solid lightgray;
            border-radius: 8px;
            display: flex;
            align-items: center;
        }

        .search i {
            margin-left: 15px;
            color: gray;
        }

        .search input {
            flex: 1;
            height: 100%;
            border: none;
            outline: none;
            padding: 0 12px;
        }

        .search button {
            height: 100%;
            width: 90px;
            background: white;
            color: royalblue;
            border: none;
            border-left: 1px solid lightgray;
            cursor: pointer;
        }

        .header-menu {
            display: flex;
            gap: 25px;
            align-items: center;

            color: #555;
            font-size: 13px;
        }

        .header-menu i {
            color: #087cff;
        }

        .suggestions {
            width: 1200px;
            margin: auto;
            padding-left: 120px;
            padding-bottom: 10px;
            color: gray;
            font-size: 11px;
        }

        .benefits {
            border-top: 1px solid lightgray;
            width: 1200px;
            height: 40px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
        }

        .benefits i {
            color: royalblue;
            margin-right: 5px;
        }

        .container {
            width: 1200px;
            margin: auto;
        }

        .breadcrumb {
            font-size: 11px;
            color: gray;
            padding: 15px 0;
        }

        .layout {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 12px;
        }

        .sidebar {
            background: white;
            border-radius: 6px;
            padding: 12px;
        }

        .sidebar h3 {
            font-size: 13px;
            margin-bottom: 10px;
        }

        .sidebar a {
            display: block;
            padding: 9px 3px;
            border-bottom: 1px solid lightgray;
            font-size: 11px;
            color: gray;
            text-decoration: none;
        }

        .side-product {
            margin-top: 12px;
            background: white;
            border: 1px solid lightgray;
            border-radius: 5px;
            padding: 10px;
            text-align: center;
        }

        .side-product img {
            width: 100px;
            height: 120px;
            object-fit: contain;
        }

        .side-product h4 {
            font-size: 10px;
            line-height: 15px;
        }
        .side-product .stars {
            color: orange;
            font-size: 9px;
            margin-top: 5px;
        }

        .side-product .price {
            font-size: 12px;
            font-weight: bold;
            margin: 7px 0;
        }

        .side-product button {
            border: none;
            background: royalblue;
            color: white;
            padding: 6px 15px;
            border-radius: 4px;
            font-size: 9px;
        }

        .main {
            min-width: 0;
        }

        .title {
            background: white;
            padding: 15px;
            border-radius: 6px;
            font-size: 20px;
            margin-bottom: 10px;
        }

        .banner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .banner img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
        }

        .category {
            margin-top: 10px;
            background: white;
            padding: 15px;
            border-radius: 6px;
        }

        .category h2 {
            font-size: 14px;
            margin-bottom: 15px;
        }

        .category-list {
            display: flex;
            justify-content: space-around;
        }

        .category-item {
            text-align: center;
            width: 130px;
        }

        .category-item img {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            object-fit: cover;
            background: lightgray;
        }

        .category-item p {
            margin-top: 7px;
            font-size: 9px;
        }

        .product-section {
            margin-top: 10px;
            background: white;
            padding: 15px;
            border-radius: 6px;
        }

        .product-section h2 {
            font-size: 15px;
            margin-bottom: 15px;
        }

        .filters {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
        }

        .filters button {
            background: white;
            border: 1px solid lightgray;
            border-radius: 15px;
            padding: 7px 12px;
            font-size: 10px;
            cursor: pointer;
        }

        .filters button:hover {
            color: royalblue;
            border-color: royalblue;
        }

        .sub-filter {
            margin: 15px 0;
            display: flex;
            gap: 20px;
            font-size: 10px;
            align-items: center;
        }

        .sort {
            margin-left: auto;
        }

        .sort button {
            border: 1px solid lightgray;
            background: white;
            padding: 6px 12px;
            border-radius: 5px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .product {
            border: 1px solid lightgray;
            border-radius: 6px;
            overflow: hidden;
            background: white;
            transition: 0.2s;
        }

        .product:hover {
            transform: translateY(-3px);
            box-shadow:
                0 5px 15px rgba(0,0,0,0.12);
        }

        .product-image {
            width: 100%;
            height: 190px;
            background: lightgray;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-image img {
            width: 90%;
            height: 90%;
            object-fit: contain;
        }

        .product-info {
            padding: 10px;
        }

        .brand {
            color: gray;
            font-size: 8px;
            margin-bottom: 5px;
        }

        .product-name {
            font-size: 11px;
            line-height: 16px;
            height: 34px;
        }

        .stars {
            color: orange;
            font-size: 10px;
            margin-top: 6px;
        }

        .sold {
            color: gray;
            margin-left: 5px;
        }

        .product-price {
            font-size: 14px;
            font-weight: bold;
            margin-top: 7px;
        }

        .sale {
            color: red;
        }

        .old-price {
            color: gray;
            font-size: 8px;
            text-decoration: line-through;
            margin-left: 5px;
        }

        .tag {
            display: inline-block;
            border: 1px solid lightgray;
            border-radius: 3px;
            font-size: 8px;
            color: gray;
            padding: 3px 5px;
            margin-top: 8px;
        }

        .shipping {
            border-top: 1px solid lightgray;
            margin-top: 8px;
            padding-top: 8px;
            color: red;
            font-size: 8px;
        }

        media(max-width: 1000px) {
            .header,
            .suggestions,
            .benefits,
            .container {
                width: 95%;
            }

            .search {
                width: auto;
            }
        }

        media(max-width: 700px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                display: none;
            }

            .banner {
                grid-template-columns: 1fr;
            }

            .products {
                grid-template-columns: repeat(2, 1fr);
            }

            .header-menu {
                display: none;
            }
        }

    </style>
</head>
<body>
    <div class="top">
        Freeship đơn từ 45K,
        giảm nhiều hơn cùng
        <b>FREESHIP XTRA</b>
    </div>

