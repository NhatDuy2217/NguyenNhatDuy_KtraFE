                <button onclick="search()">Tìm kiếm</button>
            </div>

            <div class="header-menu">
                <span><i class="fas fa-home"></i>Trang chủ</span>
                <span><i class="far fa-user"></i>Tài khoản</span>
                <span><i class="fas fa-shopping-cart"></i></span>
