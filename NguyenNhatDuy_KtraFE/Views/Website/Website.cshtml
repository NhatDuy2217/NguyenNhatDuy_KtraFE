    <script language="JavaScript">
        function search() {
            let keyword =
                document.getElementById("search").value;
            if (keyword.trim() === "") {
                alert("Vui lòng nhập sản phẩm cần tìm!");
            } else {
                alert(
                    "Bạn đang tìm kiếm: "
                    + keyword
                );
            }
        }
    </script>
</body>
</html>